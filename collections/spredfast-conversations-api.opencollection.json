    {
      "info": {
        "name": "Get Messages",
        "type": "http"
      },
      "http": {
        "method": "GET",
        "url": "https://api.spredfast.com/v2/conversations/calendar/messages",
        "params": [
          {
            "name": "initiativeIds",
            "value": "",
            "type": "query",
            "description": "CSV list of initiatives to filter by. All initiatives are included when absent."
          },
          {
            "name": "planIds",
            "value": "",
            "type": "query",
            "description": "CSV list of Plan ids to filter messages by. All plans are included in the search when absent."
          },
          {
            "name": "perPage",
            "value": "",
            "type": "query",
            "description": "Number of messages to include in each page of results. Default is 25. Must be between 1 and 50."
          },
          {
            "name": "startDate",
            "value": "",
            "type": "query",
            "description": "ISO-8601 formatted date and time for the earliest published result. **Format:** date-time"
          },
          {
            "name": "endDate",
            "value": "",
            "type": "query",
            "description": "ISO-8601 formatted date and time for the latest published result. **Format:** date-time"
          },
          {
            "name": "after",
            "value": "",
            "type": "query",
            "description": "String representing the current cursor within paged data."
          }
        ]
      },
      "docs": "Get a list of messages posted or scheduled to be posted from Khoros Marketing"
